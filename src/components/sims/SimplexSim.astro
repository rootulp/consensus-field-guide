---
import '../../styles/sim.css';
import PlaybackControls from './PlaybackControls.astro';
import { LEADERS, VIEWS } from '../../lib/sims/simplex';
---

<section class="sim" data-sim="simplex" aria-labelledby="simplex-sim-h">
  <div class="sim-head">
    <h2 id="simplex-sim-h">Watch: seven views, one bad leader</h2>
    <PlaybackControls />
  </div>

  <button type="button" class="btn btn-quiet" data-act="faulty" aria-pressed="true">View 4 leader offline</button>

  <div class="sim-scroll">
    <ol class="sim-views" style={`grid-template-columns: repeat(${VIEWS}, minmax(112px, 1fr)); min-width: 860px`}>
      {
        LEADERS.map((leader, i) => (
          <li class="sim-view" data-view={i} data-status="pending">
            <div class="sim-view-top">
              <span>view {i + 1}</span>
              <span>{leader}</span>
            </div>
            <div class="sim-block" data-block>—</div>
            <div class="sim-chip" data-chip>not started</div>
          </li>
        ))
      }
    </ol>
  </div>

  <p class="sim-caption" aria-live="polite" data-caption>Press play to watch Simplex run.</p>

  <div class="sim-legend">
    <span><i style="border: 2px solid var(--accent)"></i>proposed by the view’s leader (P1–P4)</span>
    <span><i style="background: var(--accent)"></i>notarized: 2/3 voted, next view starts</span>
    <span><i style="background: var(--good)"></i>finalized: 2/3 sent finalize</span>
    <span><i style="background: #8a8f99"></i>nullified: timed out</span>
  </div>
</section>

<script>
  import { setupPlayback } from '../../lib/playback';
  import { initialState, isDone, step, LEADERS, type SimplexState, type SimplexStatus } from '../../lib/sims/simplex';

  const CHIP: Record<SimplexStatus, string> = {
    pending: 'not started',
    proposed: 'collecting votes',
    waiting: 'leader silent…',
    notarized: 'notarized',
    finalized: 'final ✓',
    nullified: 'nullified',
  };

  for (const root of document.querySelectorAll<HTMLElement>('[data-sim="simplex"]')) {
    let s: SimplexState = initialState(true);
    const views = [...root.querySelectorAll<HTMLElement>('[data-view]')];
    const caption = root.querySelector<HTMLElement>('[data-caption]')!;
    const faultyBtn = root.querySelector<HTMLButtonElement>('[data-act="faulty"]')!;

    const render = () => {
      views.forEach((el, i) => {
        const status = s.st[i];
        el.dataset.changed = String(el.dataset.status !== status);
        if (el.dataset.status !== status) el.dataset.status = status;
        el.classList.toggle('active', i === s.cur);
        el.querySelector('[data-block]')!.textContent =
          status === 'pending' ? '—' : status === 'waiting' ? '?' : status === 'nullified' ? '⊥' : `B${i + 1}`;
        el.querySelector('[data-chip]')!.textContent = CHIP[status];
        el.querySelector(".sim-view-top span:last-child")!.textContent = LEADERS[i];
      });
      caption.textContent = s.last || 'Press play to watch Simplex run.';
      faultyBtn.setAttribute('aria-pressed', String(s.leaderOffline));
    };

    const advance = () => {
      s = step(s);
      render();
    };

    const playback = setupPlayback(root, {
      advance,
      reset: () => { s = initialState(s.leaderOffline); render(); },
      isDone: () => isDone(s),
    });
    faultyBtn.addEventListener('click', () => {
      s = initialState(!s.leaderOffline);
      playback.reset();
    });

    render();
  }
</script>
