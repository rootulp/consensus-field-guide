---
import '../../styles/sim.css';
import { PHASES } from '../../lib/sims/tendermint';

// Validator positions on the 560 x 440 stage: top, right, bottom, left.
const POS = [
  { x: 280, y: 60 },
  { x: 500, y: 220 },
  { x: 280, y: 380 },
  { x: 60, y: 220 },
];
const links: [number, number][] = [
  [0, 1], [0, 2], [0, 3], [1, 2], [1, 3], [2, 3],
];
---

<section class="sim" data-sim="tendermint" data-pos={JSON.stringify(POS)} aria-labelledby="tm-sim-h">
  <div class="sim-head">
    <h2 id="tm-sim-h">Watch: one block, four validators</h2>
    <div class="sim-controls">
      <button type="button" class="btn" data-act="play">Pause</button>
      <button type="button" class="btn btn-quiet" data-act="step">Step</button>
    </div>
  </div>

  <div class="tm-top">
    <div class="mono">height <strong data-height>6</strong> · round <strong data-round>0</strong></div>
    <div class="segmented" role="group" aria-label="Offline validators">
      <button type="button" class="btn btn-quiet" data-offline="0" aria-pressed="true">All online</button>
      <button type="button" class="btn btn-quiet" data-offline="1" aria-pressed="false">V4 offline</button>
      <button type="button" class="btn btn-quiet" data-offline="2" aria-pressed="false">V3 + V4 offline</button>
    </div>
  </div>

  <div class="tm-stage-scroll">
    <div class="tm-stage">
      <svg width="560" height="440" viewBox="0 0 560 440" aria-hidden="true">
        {links.map(([a, b]) => <line x1={POS[a].x} y1={POS[a].y} x2={POS[b].x} y2={POS[b].y} />)}
      </svg>
      <div class="tm-packets" data-packets aria-hidden="true"></div>
      {
        POS.map((p, i) => (
          <div class="tm-validator" data-v={i} style={`left:${p.x - 75}px;top:${p.y - 32}px`}>
            <div class="tm-circle">V{i + 1}</div>
            <div class="tm-badge" data-badge>waiting</div>
          </div>
        ))
      }
      <div class="tm-final" data-final hidden>final ✓</div>
    </div>
  </div>

  <ol class="tm-phases" aria-label="Steps of a height">
    {
      PHASES.map((label, i) => (
        <li data-phase={i}>
          <span class="mono">0{i + 1}</span>
          <span class="tm-phase-label">{label}</span>
        </li>
      ))
    }
  </ol>

  <p class="sim-caption" aria-live="polite" data-caption></p>

  <div class="tm-tally">
    <div class="tm-tally-row"><span data-tally>no votes yet</span><span>need more than 2/3</span></div>
    <div class="tm-tally-bar">
      <div data-tally-fill></div>
      <div class="tm-threshold"></div>
    </div>
  </div>

  <div class="tm-chain">
    <span class="label">Committed chain</span>
    <div class="tm-blocks" data-chain></div>
    <span class="muted">never reverted</span>
  </div>

  <div class="sim-legend">
    <span><i style="background: var(--rust)"></i>block proposal</span>
    <span><i style="background: var(--accent); border-radius: 7px"></i>prevote</span>
    <span><i style="background: #6d28d9; border-radius: 7px"></i>precommit</span>
  </div>
</section>

<script>
  import {
    describe,
    initialState,
    isOffline,
    onlineCount,
    proposer,
    setOffline,
    step,
    N,
    type TendermintState,
  } from '../../lib/sims/tendermint';

  const STATUS = ['waiting for block', 'prevoted', 'locked · precommitted', 'committed'];

  for (const root of document.querySelectorAll<HTMLElement>('[data-sim="tendermint"]')) {
    const pos: { x: number; y: number }[] = JSON.parse(root.dataset.pos!);
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let s: TendermintState = initialState();
    let playing = !reduce;

    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const packets = $('[data-packets]');
    const validators = [...root.querySelectorAll<HTMLElement>('[data-v]')];
    const phases = [...root.querySelectorAll<HTMLElement>('[data-phase]')];
    const offlineButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-offline]')];

    function send(from: number, to: number, kind: 'block' | 'prevote' | 'precommit', delay: number) {
      const el = document.createElement('div');
      el.className = `tm-packet tm-${kind}`;
      el.style.left = `${pos[from].x - 7}px`;
      el.style.top = `${pos[from].y - 7}px`;
      packets.append(el);
      if (reduce) return;
      el.animate(
        [
          { transform: 'translate(0, 0)', opacity: 0 },
          { opacity: 1, offset: 0.12 },
          { opacity: 1, offset: 0.88 },
          { transform: `translate(${pos[to].x - pos[from].x}px, ${pos[to].y - pos[from].y}px)`, opacity: 0 },
        ],
        { duration: 1200, delay, easing: 'ease-in-out', fill: 'both' },
      );
    }

    function animatePackets() {
      packets.replaceChildren();
      if (s.timeout || s.stalled) return;
      const p = proposer(s);
      if (s.phase === 0 && !isOffline(s, p)) {
        for (let v = 0; v < N; v++) if (v !== p) send(p, v, 'block', 0);
      }
      if (s.phase === 1 || s.phase === 2) {
        const kind = s.phase === 1 ? 'prevote' : 'precommit';
        for (let a = 0; a < N; a++) {
          if (isOffline(s, a)) continue;
          for (let b = 0; b < N; b++) if (a !== b) send(a, b, kind, a * 80);
        }
      }
    }

    function render(animate: boolean) {
      const p = proposer(s);
      $('[data-height]').textContent = String(s.height);
      $('[data-round]').textContent = String(s.round);
      validators.forEach((el, i) => {
        const off = isOffline(s, i);
        const isProp = i === p && !s.timeout;
        el.classList.toggle('off', off);
        el.classList.toggle('proposer', isProp && !off);
        let status: string;
        if (off) status = 'offline';
        else if (s.stalled) status = 'waiting for 2/3';
        else if (s.timeout) status = 'timeout · prevote nil';
        else if (s.phase === 0) status = i === p ? 'proposer' : STATUS[0];
        else status = s.phase === 3 ? `committed #${s.height}` : STATUS[s.phase];
        el.querySelector('[data-badge]')!.textContent = status;
      });
      phases.forEach((el, i) => el.classList.toggle('on', i === s.phase && !s.timeout));
      $('[data-caption]').textContent = describe(s);
      $('[data-final]').hidden = !(s.phase === 3 && !s.timeout);

      const voting = !s.timeout && s.phase >= 1;
      const votes = voting ? onlineCount(s) : 0;
      $('[data-tally]').textContent = voting ? `${votes} of ${N} validators voting` : 'no votes yet';
      const fill = $('[data-tally-fill]');
      fill.style.width = `${(votes / N) * 100}%`;
      fill.style.background = votes * 3 > N * 2 ? 'var(--good)' : 'var(--rust)';

      $('[data-chain]').replaceChildren(
        ...s.chain.map((h, i) => {
          const b = document.createElement('span');
          b.className = i === s.chain.length - 1 ? 'tm-block latest' : 'tm-block';
          b.textContent = `#${h}`;
          return b;
        }),
      );
      $('[data-act="play"]').textContent = playing ? 'Pause' : 'Play';
      offlineButtons.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.offline) === s.offlineCount)));
      if (animate) animatePackets();
    }

    const advance = () => {
      s = step(s);
      render(true);
    };

    $('[data-act="play"]').addEventListener('click', () => {
      playing = !playing;
      render(false);
    });
    $('[data-act="step"]').addEventListener('click', () => {
      playing = false;
      advance();
    });
    offlineButtons.forEach((b) =>
      b.addEventListener('click', () => {
        s = setOffline(s, Number(b.dataset.offline));
        render(true);
      }),
    );

    setInterval(() => {
      if (playing) advance();
    }, 2400);
    render(true);
  }
</script>

<style>
  .tm-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-top: 20px;
  }

  .mono {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
  }

  .mono strong {
    color: var(--ink);
  }

  .tm-stage-scroll {
    overflow-x: auto;
    margin-top: 8px;
    display: flex;
  }

  .tm-stage {
    position: relative;
    width: 560px;
    height: 440px;
    flex: none;
    margin: 0 auto;
  }

  .tm-stage svg {
    position: absolute;
    inset: 0;
  }

  .tm-stage line {
    stroke: var(--rule);
    stroke-width: 1.5;
  }

  .tm-packets :global(.tm-packet) {
    position: absolute;
    width: 14px;
    height: 14px;
    opacity: 0;
  }

  .tm-packets :global(.tm-block) {
    background: var(--rust);
    border-radius: 3px;
  }

  .tm-packets :global(.tm-prevote) {
    background: var(--accent);
    border-radius: 7px;
  }

  .tm-packets :global(.tm-precommit) {
    background: #6d28d9;
    border-radius: 7px;
  }

  .tm-validator {
    position: absolute;
    width: 150px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    z-index: 1;
  }

  .tm-circle {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    background: var(--paper);
    border: 3px solid var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 18px;
  }

  .tm-validator.proposer .tm-circle {
    border-color: var(--rust);
  }

  .tm-validator.off {
    opacity: 0.5;
  }

  .tm-validator.off .tm-circle {
    border: 2px dashed #8a8f99;
  }

  .tm-badge {
    font-family: var(--mono);
    font-size: 11px;
    padding: 3px 8px;
    background: #f2f3f5;
    color: var(--ink-2);
    white-space: nowrap;
  }

  .tm-validator.proposer .tm-badge {
    color: #8a3e07;
    background: #fbf0e6;
  }

  .tm-final {
    position: absolute;
    left: 230px;
    top: 196px;
    width: 100px;
    height: 48px;
    background: var(--good);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    animation: sim-rise 0.35s ease-out both;
  }

  .tm-phases {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }

  .tm-phases li {
    padding: 8px 12px;
    border: 1px solid var(--rule);
    color: var(--muted);
  }

  .tm-phases li.on {
    border-color: var(--accent);
    background: #eef1fc;
    color: var(--ink);
  }

  .tm-phase-label {
    display: block;
    font-weight: 600;
  }

  .tm-tally {
    margin-top: 8px;
  }

  .tm-tally-row {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    color: var(--ink-2);
  }

  .tm-tally-bar {
    position: relative;
    height: 10px;
    background: var(--rule);
    margin-top: 6px;
    overflow: hidden;
  }

  .tm-tally-bar [data-tally-fill] {
    height: 10px;
    width: 0;
    transition: width 0.5s;
  }

  .tm-threshold {
    position: absolute;
    left: 66.7%;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--ink);
  }

  .tm-chain {
    margin-top: 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  .tm-blocks {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tm-blocks :global(.tm-block) {
    font-family: var(--mono);
    font-size: 13px;
    padding: 8px 12px;
    border: 1px solid var(--rule-2);
  }

  .tm-blocks :global(.tm-block.latest) {
    border-color: var(--good);
    color: var(--good-ink);
    animation: sim-rise 0.35s ease-out both;
  }

  .muted {
    font-size: 13px;
    color: var(--muted);
  }

  @media (max-width: 720px) {
    .tm-phases {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
