---
import '../../styles/sim.css';
import PlaybackControls from './PlaybackControls.astro';
import type { GuideLesson } from '../../data/lessons/types';
interface Props { id: string; walkthrough: GuideLesson['walkthrough'] }
const { id, walkthrough } = Astro.props;
const first = walkthrough.scenarios[0].frames[0];
---
<section class="sim walkthrough" data-walkthrough data-scenarios={JSON.stringify(walkthrough.scenarios)} aria-labelledby={`${id}-walkthrough`}>
  <div class="sim-head">
    <h2 id={`${id}-walkthrough`}>{walkthrough.title}</h2>
    <PlaybackControls />
  </div>
  <label class="scenario-picker">Explore a scenario
    <select data-scenario>
      {walkthrough.scenarios.map((scenario, i) => <option value={i}>{scenario.name}</option>)}
    </select>
  </label>
  <p class="model-note"><strong>Teaching model:</strong> {walkthrough.model}</p>
  <div class="trace-heading">
    <h3 data-frame-title>{first.title}</h3>
    <span data-frame-number>1 / {walkthrough.scenarios[0].frames.length}</span>
  </div>
  <div class="trace-cards" data-cards>
    {first.cards.map(card => <div class="trace-card" data-tone={card.tone}><h4>{card.label}</h4><p>{card.value}</p><span class="change-marker"></span></div>)}
  </div>
  <p class="sim-caption" data-caption aria-live="polite" aria-atomic="true">{first.explanation}</p>
  <details class="trace-history">
    <summary>Steps so far</summary>
    <ol data-history><li><strong>{first.title}</strong> — {first.explanation}</li></ol>
  </details>
  <noscript><p>Enable JavaScript for the step controls. The lesson and initial diagram remain readable without it.</p></noscript>
</section>

<script>
  import { setupPlayback } from '../../lib/playback';
  import { advanceWalkthrough, changedCards, currentFrame, initialWalkthrough, walkthroughDone } from '../../lib/sims/walkthrough';
  import type { Frame, Scenario } from '../../data/lessons/types';

  for (const root of document.querySelectorAll<HTMLElement>('[data-walkthrough]')) {
    const scenarios: Scenario[] = JSON.parse(root.dataset.scenarios!);
    let state = initialWalkthrough();
    let previous: Frame | undefined;
    const $ = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector)!;
    function render() {
      const frame = currentFrame(scenarios, state);
      const changed = changedCards(previous, frame);
      $('[data-frame-title]').textContent = frame.title;
      $('[data-frame-number]').textContent = `${state.frame + 1} / ${scenarios[state.scenario].frames.length}`;
      $('[data-caption]').textContent = frame.explanation;
      $('[data-cards]').replaceChildren(...frame.cards.map((card, i) => {
        const el = document.createElement('div');
        el.className = 'trace-card';
        el.dataset.tone = card.tone;
        el.dataset.changed = String(changed[i]);
        const title = document.createElement('h4'); title.textContent = card.label;
        const value = document.createElement('p'); value.textContent = card.value;
        const marker = document.createElement('span'); marker.className = 'change-marker';
        marker.textContent = changed[i] ? 'Changed this step' : '';
        el.append(title, value, marker);
        return el;
      }));
      $('[data-history]').replaceChildren(...scenarios[state.scenario].frames.slice(0, state.frame + 1).map(frame => {
        const li = document.createElement('li');
        const title = document.createElement('strong'); title.textContent = frame.title;
        li.append(title, ` — ${frame.explanation}`);
        return li;
      }));
      previous = frame;
    }
    const playback = setupPlayback(root, {
      advance: () => { state = advanceWalkthrough(scenarios, state); render(); },
      reset: () => { state = initialWalkthrough(state.scenario); previous = undefined; render(); },
      isDone: () => walkthroughDone(scenarios, state),
    });
    $('[data-scenario]').addEventListener('change', event => {
      state = initialWalkthrough(Number((event.target as HTMLSelectElement).value));
      playback.reset();
    });
    render();
  }
</script>

<style>
  .scenario-picker { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 20px; font-weight: 600; }
  select { font: inherit; color: var(--ink); background: var(--paper); padding: 10px; border: 1px solid var(--rule-2); max-width: 100%; min-width: 0; }
  .model-note { font-size: 14px; color: var(--muted); margin: 16px 0 24px; }
  .trace-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .trace-heading h3 { font-size: 24px; margin: 0 0 16px; }
  .trace-heading span { white-space: nowrap; font: 13px var(--mono); }
  .trace-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; }
  .trace-cards :global(.trace-card) { min-width: 0; padding: 16px; border: 1px solid var(--rule-2); border-top-width: 4px; background: var(--wash); overflow-wrap: anywhere; }
  .trace-cards :global(h4) { font: 600 14px var(--sans); margin: 0 0 12px; }
  .trace-cards :global(p) { font: 16px/1.7 var(--mono); margin: 0; min-height: 3.4em; }
  .trace-cards :global([data-tone='active']) { border-top-color: var(--accent); background: var(--wash-blue); }
  .trace-cards :global([data-tone='good']) { border-top-color: var(--good); background: var(--good-wash); }
  .trace-cards :global([data-tone='warn']) { border-top-color: var(--rust); background: #fff7ed; }
  .trace-cards :global([data-changed='true']) { outline: 2px solid var(--accent); outline-offset: -2px; animation: trace-arrive .7s ease-out; }
  .trace-cards :global(.change-marker) { display: block; min-height: 1.6em; margin-top: 12px; color: var(--accent-ink); font-size: 12px; font-weight: 600; }
  .trace-history { margin-top: 18px; font-size: 15px; }
  .trace-history summary { cursor: pointer; padding-block: 8px; }
  .trace-history :global(li) { margin-block: 12px; }
  @keyframes trace-arrive { from { transform: translateY(4px); } to { transform: none; } }
  @media (max-width: 420px) { .trace-cards { grid-template-columns: 1fr; } }
</style>
