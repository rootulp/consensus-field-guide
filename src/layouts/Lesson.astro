---
import Base from './Base.astro';
import { byId, childrenOf, displayYear, families, lessonHref, lessons, parentsOf } from '../data/protocols';

interface Paper {
  title: string;
  authors: string;
  year: string;
  href: string;
  note?: string;
}

interface Props {
  /** Protocol id from src/data/protocols.ts. */
  id: string;
  /** One-sentence summary under the title. */
  dek: string;
  /** Lessons or ideas that help to know first. */
  before: string[];
  papers: Paper[];
}

const { id, dek, before, papers } = Astro.props;
const p = byId[id];
const fam = families[p.family];
const parents = parentsOf(id);
const children = childrenOf(id);
const idx = lessons.findIndex((l) => l.id === id);
const prev = lessons[idx - 1];
const next = lessons[idx + 1];
const nodeHref = (q: typeof p) => lessonHref(q) ?? `/?p=${q.id}`;
---

<Base title={`${p.name} · The Consensus Field Guide`} description={dek} nav="lessons">
  <div class="wrap-narrow">
    <nav aria-label="Breadcrumb" class="crumbs">
      <a href={`/?p=${p.id}`}>Family tree</a>
      <span aria-hidden="true">/</span>
      <span>{fam.label}</span>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{p.name}</span>
    </nav>

    <header class="head">
      <div class="row">
        <span class="chip" style={`background:${fam.color}`}>{fam.label}</span>
        <span class="by">{displayYear(p)} · {p.who}</span>
      </div>
      <h1>{p.name}</h1>
      <p class="dek">{dek}</p>
      <div class="row tags">
        <span class="tag">{p.minutes} min</span>
        {before.length > 0 && <span class="tag">Helps to know: {before.join(', ')}</span>}
      </div>
    </header>

    <section class="family" aria-labelledby="family-h">
      <div class="family-head">
        <h2 id="family-h">Where {p.name} sits in the family</h2>
        <a href={`/?p=${p.id}`}>See the full family tree →</a>
      </div>
      <div class="family-row">
        <div class="family-col">
          <div class="label">Built on</div>
          {
            parents.map((q) => (
              <a class="fnode" href={nodeHref(q)} style={`--c:${families[q.family].color}`}>
                <span class="fy">{displayYear(q)}</span>
                <span class="fn">{q.name}</span>
              </a>
            ))
          }
        </div>
        <svg class="arrow" width="32" height="16" viewBox="0 0 32 16" aria-hidden="true"><path d="M2 8h26M22 3l6 5-6 5"></path></svg>
        <div class="family-self" style={`background:${fam.color}`}>
          <span class="fy">{displayYear(p)} · this lesson</span>
          <span class="self-name">{p.name}</span>
        </div>
        <svg class="arrow" width="32" height="16" viewBox="0 0 32 16" aria-hidden="true"><path d="M2 8h26M22 3l6 5-6 5"></path></svg>
        <div class="family-col">
          <div class="label">Led to</div>
          {
            children.length ? (
              children.map((q) => (
                <a class="fnode" href={nodeHref(q)} style={`--c:${families[q.family].color}`}>
                  <span class="fy">{displayYear(q)}</span>
                  <span class="fn">{q.name}</span>
                </a>
              ))
            ) : (
              <span class="empty">The frontier, for now</span>
            )
          }
        </div>
      </div>
    </section>

    <div class="sim-slot">
      <slot name="sim" />
    </div>

    <div class="body">
      <article class="prose">
        <slot />
      </article>
      <aside class="side">
        <slot name="side" />
      </aside>
    </div>

    <section class="papers" aria-labelledby="papers-h">
      <h2 id="papers-h">Go to the source</h2>
      <ul>
        {
          papers.map((x) => (
            <li>
              <a href={x.href}>{x.title}</a>
              <span class="pa">
                {x.authors}, {x.year}
                {x.note && ` · ${x.note}`}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="done">
      <button type="button" class="btn" data-mark={p.lesson} aria-pressed="false">Mark this lesson as read</button>
    </div>

    <nav aria-label="Lesson navigation" class="pager">
      {prev ? <a href={lessonHref(prev)}>← {prev.name}, {prev.year}</a> : <a href="/">← Family tree</a>}
      {
        next ? (
          <a class="btn btn-primary" href={lessonHref(next)}>
            Next: {next.name}, {next.year} →
          </a>
        ) : (
          <a class="btn btn-primary" href="/">
            Back to the family tree →
          </a>
        )
      }
    </nav>
  </div>
</Base>

<script>
  import { readLessons, setLessonRead } from '../lib/progress';

  const btn = document.querySelector<HTMLButtonElement>('[data-mark]');
  if (btn) {
    const id = btn.dataset.mark!;
    const render = (read: boolean) => {
      btn.setAttribute('aria-pressed', String(read));
      btn.textContent = read ? '✓ Read. Click to unmark' : 'Mark this lesson as read';
    };
    render(readLessons().has(id));
    btn.addEventListener('click', () => {
      const read = !readLessons().has(id);
      setLessonRead(id, read);
      render(read);
    });
  }
</script>

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    padding-top: 20px;
    font-size: 14px;
    color: var(--muted);
  }

  .crumbs a {
    padding: 10px 0;
  }

  .crumbs [aria-current] {
    color: var(--ink);
  }

  .head {
    padding-top: 20px;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }

  .by {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--rust);
  }

  h1 {
    font-size: clamp(44px, 7vw, 60px);
    line-height: 1.05;
    margin: 12px 0 0;
  }

  .dek {
    font-family: var(--serif);
    font-size: clamp(20px, 2.4vw, 24px);
    line-height: 1.45;
    color: var(--ink-2);
    margin: 14px 0 0;
    max-width: 820px;
  }

  .tags {
    margin-top: 20px;
  }

  .family {
    margin-top: 40px;
    background: var(--wash);
    padding: 24px 28px;
  }

  .family-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    align-items: baseline;
  }

  .family h2 {
    font-size: 22px;
    margin: 0;
    font-weight: 600;
  }

  .family-head a {
    font-size: 14px;
    padding: 10px 0;
  }

  .family-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    margin-top: 16px;
  }

  .family-col {
    flex: 1 1 220px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .fnode {
    display: block;
    background: var(--paper);
    border: 1px solid #d5d8de;
    border-left: 5px solid var(--c);
    padding: 10px 12px;
    text-decoration: none;
    color: var(--ink);
  }

  .fnode:hover {
    border-color: var(--c);
    color: var(--ink);
  }

  .fy {
    display: block;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
  }

  .fn {
    display: block;
    font-weight: 600;
  }

  .family-self {
    flex: 1 1 200px;
    color: #fff;
    padding: 16px;
  }

  .family-self .fy {
    color: #fff;
    opacity: 0.9;
  }

  .self-name {
    display: block;
    font-family: var(--serif);
    font-size: 24px;
    font-weight: 700;
  }

  .arrow path {
    fill: none;
    stroke: var(--muted);
    stroke-width: 2;
  }

  .empty {
    font-size: 14px;
    color: var(--muted);
  }

  .sim-slot {
    margin-top: 40px;
  }

  .body {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    margin-top: 48px;
  }

  .prose {
    flex: 999 1 520px;
    min-width: 0;
  }

  .prose :global(h2) {
    font-size: 30px;
    margin: 40px 0 0;
    font-weight: 600;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p) {
    margin: 14px 0 0;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 14px 0 0;
    padding-left: 22px;
  }

  .prose :global(li + li) {
    margin-top: 8px;
  }

  .side {
    flex: 1 1 320px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .side :global(.box) {
    background: var(--wash-blue);
    padding: 22px;
  }

  .side :global(.box h3) {
    margin: 0;
    font-family: var(--sans);
    font-size: 17px;
    font-weight: 600;
  }

  .side :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-top: 12px;
    font-size: 14px;
    line-height: 1.4;
  }

  .side :global(th) {
    text-align: left;
    font-weight: 500;
    color: var(--muted);
    padding: 6px 4px 6px 0;
    vertical-align: bottom;
  }

  .side :global(td) {
    padding: 8px 4px 8px 0;
    border-top: 1px solid #dadfea;
    vertical-align: top;
  }

  .side :global(td:first-child) {
    font-weight: 600;
  }

  .papers {
    margin-top: 56px;
  }

  .papers h2 {
    font-size: 26px;
    margin: 0;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--ink);
  }

  .papers ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .papers li {
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .papers a {
    font-weight: 600;
  }

  .pa {
    font-size: 14px;
    color: var(--muted);
  }

  .done {
    margin-top: 40px;
  }

  .pager {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-top: 24px;
    padding-top: 24px;
    border-top: 2px solid var(--ink);
  }

  .pager > a:first-child {
    padding: 12px 0;
    color: var(--ink-2);
    text-decoration: none;
  }

  @media (max-width: 720px) {
    .family {
      padding: 16px;
    }

    .arrow {
      display: none;
    }
  }
</style>
