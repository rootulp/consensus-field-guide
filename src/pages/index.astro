---
import Base from '../layouts/Base.astro';
import FamilyTree from '../components/FamilyTree.astro';
import { displayYear, families, lessonHref, lessons, protocols } from '../data/protocols';

const ordered = [...protocols].sort((a, b) => a.year - b.year);
---

<Base
  title="The Consensus Field Guide"
  description="Forty years of distributed consensus as one family tree, with interactive lessons for every topic from Byzantine Generals to Multimmit."
  nav="tree"
>
  <div class="wrap">
    <section class="hero">
      <div class="intro">
        <div class="eyebrow">Forty years of consensus, as one family</div>
        <h1>Every protocol has parents.</h1>
        <p>
          Time runs top to bottom. Each line means one protocol built on another. Pick a protocol to see where it came
          from, then open its lesson to watch it run.
        </p>
      </div>
      <div class="progress" data-progress data-total={lessons.length}>
        <div class="eyebrow muted">Your progress</div>
        <div class="count"><span data-done>0</span> / {lessons.length} lessons</div>
        <div class="bar"><div data-bar></div></div>
      </div>
    </section>

    <FamilyTree />

    <section class="list" aria-labelledby="all-h">
      <h2 id="all-h">All protocols, in order</h2>
      <ol>
        {
          ordered.map((p) => {
            const href = lessonHref(p);
            return (
              <li>
                <span class="yr">{displayYear(p)}</span>
                <span class="swatch" style={`background:${families[p.family].color}`} aria-hidden="true" />
                <span class="nm">{href ? <a href={href}>{p.name}</a> : <a href={`/?p=${p.id}`}>{p.name}</a>}</span>
                <span class="gf">{p.gift}</span>
              </li>
            );
          })
        }
      </ol>
    </section>
  </div>
</Base>

<script>
  import { readLessons } from '../lib/progress';

  const el = document.querySelector<HTMLElement>('[data-progress]')!;
  const total = Number(el.dataset.total);
  const done = readLessons().size;
  el.querySelector('[data-done]')!.textContent = String(Math.min(done, total));
  el.querySelector<HTMLElement>('[data-bar]')!.style.width = `${(100 * Math.min(done, total)) / total}%`;
</script>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 32px;
    align-items: flex-end;
    padding: 48px 0 32px;
  }

  .intro {
    max-width: 720px;
  }

  h1 {
    font-size: clamp(40px, 6vw, 56px);
    margin: 12px 0 0;
  }

  .intro p {
    font-size: 19px;
    color: var(--ink-2);
    margin: 16px 0 0;
  }

  .progress {
    min-width: 240px;
  }

  .muted {
    color: var(--muted);
  }

  .count {
    font-family: var(--serif);
    font-size: 36px;
    font-weight: 700;
    margin-top: 4px;
  }

  .bar {
    height: 4px;
    background: var(--rule);
    margin-top: 10px;
  }

  .bar div {
    height: 4px;
    width: 0;
    background: var(--accent);
  }

  .list {
    margin-top: 64px;
  }

  .list h2 {
    font-size: 30px;
    margin: 0;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--ink);
  }

  .list ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .list li {
    display: grid;
    grid-template-columns: 96px 10px minmax(160px, 220px) minmax(0, 1fr);
    gap: 16px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
  }

  .yr {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
  }

  .swatch {
    width: 10px;
    height: 10px;
  }

  .nm {
    font-weight: 600;
  }

  .nm a {
    color: var(--ink);
  }

  .gf {
    font-size: 15px;
    color: var(--ink-2);
    line-height: 1.55;
  }

  @media (max-width: 720px) {
    .list li {
      grid-template-columns: 10px minmax(0, 1fr);
      gap: 4px 12px;
    }

    .yr {
      grid-column: 2;
    }

    .swatch {
      grid-row: 1 / span 3;
      margin-top: 6px;
    }

    .nm,
    .gf {
      grid-column: 2;
    }
  }
</style>
